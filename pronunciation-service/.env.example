# Pronunciation microservice configuration. Copy to .env for local overrides.
# All values have safe defaults in core/config.py — this file only documents them.

# Environment name (dev | prod). Affects logging verbosity/format.
APP_ENV=dev
LOG_LEVEL=info

# Acoustic model. Apache-2.0, outputs IPA phonemes via CTC. Change only if you
# know the replacement also emits an espeak-compatible IPA phoneme vocabulary.
MODEL_ID=facebook/wav2vec2-xlsr-53-espeak-cv-ft

# Inference device. "cpu" everywhere for now; "cuda" if a GPU is available.
DEVICE=cpu

# Language passed to the phonemizer (espeak backend) for the TARGET text.
PHONEMIZER_LANGUAGE=en-us

# Reject uploads larger than this many bytes (defense against huge payloads).
MAX_AUDIO_BYTES=10485760
