# PostgreSQL via Docker (voir docker-compose.yml à la racine du repo).
# Port hôte 6544 : 5432 = PostgreSQL local, 5433 = autre projet, et 5433-5532
# est une plage réservée par Windows (WinNAT) où Docker ne peut pas se lier —
# d'où 6544, hors de toute plage réservée. Doit correspondre au port du compose.
APP_ENV=dev
# Tests only. Never enable in staging/production (the app refuses to start).
EXPOSE_RESET_TOKEN=false
# Empty = mailer off (forgot UI hidden). Both required to send.
RESEND_API_KEY=
MAIL_FROM=
# Staging/production: required header X-Metrics-Token for GET /metrics. Empty = 404.
METRICS_TOKEN=
DATABASE_URL=postgresql+asyncpg://apm:apm_dev_password@localhost:6544/apm
DATABASE_URL_TEST=postgresql+asyncpg://apm:apm_dev_password@localhost:6544/apm_test

# JWT — access court (refresh token pour renouveler)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate-limit /auth/login (anti brute-force)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
CHANGE_PASSWORD_RATE_LIMIT_MAX=5
CHANGE_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
CONVERSATION_RATE_LIMIT_MAX=20
CONVERSATION_RATE_LIMIT_WINDOW_SECONDS=60
DEBRIEF_RATE_LIMIT_MAX=5
DEBRIEF_RATE_LIMIT_WINDOW_SECONDS=60

# Security hardening (#120)
# Trust X-Forwarded-For for the client IP — enable ONLY behind a trusted reverse
# proxy that sets it, else a client could forge its IP to dodge rate limits.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1
# Reject audio uploads larger than this (bytes) before reading them into memory.
MAX_UPLOAD_BYTES=10485760
# Cross-instance rate limiter + TTS cache. Empty = in-memory/per-worker (dev/test
# only). REQUIRED in staging/production (redis://host:port/db) — the app refuses
# to start without it there, so limits and the TTS cache are shared across
# instances instead of silently per-worker.
REDIS_URL=

# Perf / cost (#123)
# TTS cache size (reuse audio for repeated lines). 0 disables it.
TTS_CACHE_MAX_ENTRIES=256
# Per-turn grammar correction (a 2nd LLM call). false = never correct.
CORRECTION_ENABLED=true
# Skip correction on utterances shorter than this many words (cheap short turns).
CORRECTION_MIN_WORDS=3

# Quota
FREE_TIER_DAILY_MINUTES=10

# CORS
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# Conversation / voice (DeepSeek = LLM stage; STT/TTS/LiveKit added when available)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_CONVERSATION_MAX_TOKENS=400
DEEPSEEK_DEBRIEF_MAX_TOKENS=900
DEEPSEEK_MISSION_MAX_TOKENS=500
DEEPSEEK_SHADOWING_MAX_TOKENS=300
# Conversation LLM: "fake" (no key) | "deepseek" | "groq".
# "groq" (Llama 3.3, fast, free) | "groq_fallback" (Groq puis DeepSeek en secours:
# (~0.3 s vs ~2-4 s for DeepSeek) with comparable quality — recommended for the
# live spoken turn. Uses GROQ_LLM_MODEL below.
VOICE_ENGINE=fake
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
# Voice policy: conversation ≠ drills.
# Conversation (talk orb): on-device by default (fast). Override only if needed:
# CONVERSATION_STT=device
# CONVERSATION_TTS=device
# Drills (Écho / paires / carnet): /tts + /transcribe
TTS_ENGINE=edge
STT_ENGINE=auto
LOG_LEVEL=INFO
DEBRIEF_ENGINE=fake  # "fake" | "deepseek" | "groq" (groq = rapide et fiable)
# Compiles a pasted job offer / CV / pitch into a tailored simulation.
# "fake" = generic offline brief (no key); "deepseek" = real compilation.
MISSION_ENGINE=fake
# Generates shadowing target phrases + coaches pronunciation attempts.
# "fake" = generic offline phrase/coaching (no key); "deepseek" = real.
SHADOWING_ENGINE=fake

# Phoneme-level pronunciation scoring (#111 step 2).
# "fake" = no phonetic scores (default); "gop" = call the pronunciation
# microservice (wav2vec2) at GOP_SERVICE_URL. Start it with:
#   docker compose --profile ml up pronunciation
PRONUNCIATION_ENGINE=fake
GOP_SERVICE_URL=http://localhost:8100
# Same value as the pronunciation service's INTERNAL_SECRET. Required in
# staging/production when PRONUNCIATION_ENGINE=gop (#424).
GOP_SERVICE_SECRET=
GOP_TIMEOUT_SECONDS=15.0
